# Orbiter Fusion — backend configuration (ORBITER_ prefix).
# Copy to `.env` and fill in. Only ORBITER_GEE_PROJECT is required.

# REQUIRED — your Google Earth Engine / Google Cloud project id.
# There is NO hardcoded fallback; the app refuses to start without this.
ORBITER_GEE_PROJECT=your-gcp-project-id

# GEE auth (all optional). Resolver priority: JSON string > file path > ADC.
# Local dev: run `earthengine authenticate` once and leave both blank (ADC).
# Deploy/CI: point one of these at a service-account key.
# ORBITER_GEE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# ORBITER_GEE_SERVICE_ACCOUNT_FILE=./ee-sa.json

# Use the Earth Engine high-volume endpoint (recommended for tile serving).
ORBITER_GEE_HIGH_VOLUME=true

# CORS: comma-separated list of allowed browser origins.
ORBITER_CORS_ORIGINS=http://localhost:5173

# Fusion tuning.
ORBITER_MAX_SCENES_PER_COMPOSITE=25
ORBITER_DEFAULT_CLOUD_COVER=20.0
ORBITER_MAPID_TTL_SECONDS=21600
ORBITER_EE_THREADPOOL_WORKERS=8

# Phase 1: HLS-style harmonization coefficients (Claverie 2018, operational v1.5).
# Optional: path to a JSON file with per-band [slope, intercept] pairs.
# Example file content:
#   { "blue": [0.8474, 0.0088], "green": [...], ... }
# When unset, the in-tree operational defaults are used.
# ORBITER_HLS_COEFFS=./hls_coeffs.json

# Phase 2: time-series tuning.
# Upper bound on per-scene frames returned by /api/scenes/overlap.
ORBITER_TIME_SERIES_MAX_FRAMES=50
# Concurrency cap for the frontend's per-frame loop.
ORBITER_TIME_SERIES_CONCURRENCY=4
