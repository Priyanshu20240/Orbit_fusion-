# Orbiter Fusion — frontend configuration (Vite VITE_ prefix).
# Copy to `.env.development` / `.env.production` as needed.

# Base URL of the backend API.
# Empty string  → use the Vite dev proxy (same-origin `/api`, see vite.config.js).
# Set to a full origin in production, e.g. https://api.orbiter.example.com
VITE_API_BASE_URL=
